#!/bin/sh /etc/rc.common
# procd init script for xupnpd deployed to /opt/xupnpd (USB storage)
# install: cp xupnpd.init /etc/init.d/xupnpd && chmod +x /etc/init.d/xupnpd && /etc/init.d/xupnpd enable && /etc/init.d/xupnpd start
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c "cd /opt/xupnpd && exec ./xupnpd-armel-tim"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
